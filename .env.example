# ------------------------------------------------------------------
# AI Study Copilot — environment variables
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Naming rules
#   NEXT_PUBLIC_*  -> readable by the browser (safe, public values only)
#   everything else -> server-side only, never exposed to the client
#
# The app builds, type-checks and tests fine WITHOUT these values.
# Features degrade to a clear "not configured" state until you add them.
# ------------------------------------------------------------------

# --- Supabase (auth + Postgres/pgvector + storage) ------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (public)
NEXT_PUBLIC_SUPABASE_URL=
# `anon` public key from Supabase Dashboard > Settings > API  (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# `service_role` key — SERVER ONLY. Never ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations / pgvector admin work
DATABASE_URL=

# --- Chat model (OpenAI-compatible provider) — SERVER ONLY ----------
# Works with DeepSeek, OpenAI, Groq, a local server, …
# DeepSeek example:
#   AI_CHAT_API_KEY=sk-...
#   AI_CHAT_BASE_URL=https://api.deepseek.com
#   AI_CHAT_MODEL=deepseek-flash        # or deepseek-v4-pro
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=deepseek-flash
# Aliases also accepted: DEEPSEEK_API_KEY / OPENAI_API_KEY
DEEPSEEK_API_KEY=

# --- Embeddings -----------------------------------------------------
# Default: a small multilingual model runs LOCALLY via transformers.js —
# no second API account needed. (First run downloads it from HF_ENDPOINT.)
HF_ENDPOINT=https://hf-mirror.com
AI_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Must match the vector dimension in supabase/migrations (384 by default).
AI_EMBEDDING_DIM=384
# e5 models expect "query: " / "passage: " prefixes ("e5" or "none").
AI_EMBEDDING_PREFIXES=e5
# To use a hosted OpenAI-compatible embeddings API instead, also set:
#   AI_EMBEDDING_API_KEY=...
#   AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
#   AI_EMBEDDING_MODEL=text-embedding-3-small
#   AI_EMBEDDING_DIM=1536   (+ update vector(...) in the migrations)
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=

# --- App ------------------------------------------------------------
# Canonical origin, used for redirects / links outside requests
APP_URL=http://localhost:3000
