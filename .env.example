# ------------------------------------------------------------------
# AI Study Copilot — environment variables
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Naming rules
#   NEXT_PUBLIC_*  -> readable by the browser (safe, public values only)
#   everything else -> server-side only, never exposed to the client
#
# The app builds, type-checks and tests fine WITHOUT these values.
# Features degrade to a clear "not configured" state until you add them.
# ------------------------------------------------------------------

# --- Supabase (auth + Postgres + storage) --------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (public)
NEXT_PUBLIC_SUPABASE_URL=
# `anon` public key from Supabase Dashboard > Settings > API  (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# `service_role` key — SERVER ONLY. Used for privileged operations
# (e.g. reading files back for processing). Never ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for migrations / pgvector admin work,
# e.g. postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- OpenAI (chat + embeddings) — SERVER ONLY ----------------------
OPENAI_API_KEY=
# Embeddings model used by the RAG pipeline
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Default chat model used for tutor answers & quiz generation
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- App ------------------------------------------------------------
# Canonical origin, used for redirects / links outside requests
APP_URL=http://localhost:3000
